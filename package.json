{
  "name": "antigravity-langpack",
  "version": "1.6.0",
  "description": "Zero-binary, zero-dependency multi-language UI pack (14 languages / 15 locales, 2,065 entries each, full Marketplace coverage & opt-in AI thinking language sync) for Google Antigravity on Windows, macOS & Linux.",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "antigravity-langpack": "./cli.mjs"
  },
  "scripts": {
    "check": "node cli.mjs check",
    "test": "node --disable-warning=ExperimentalWarning --test test/verify.test.mjs",
    "install-i18n": "node --disable-warning=ExperimentalWarning cli.mjs install",
    "uninstall-i18n": "node --disable-warning=ExperimentalWarning cli.mjs uninstall",
    "status": "node --disable-warning=ExperimentalWarning cli.mjs status",
    "lang": "node --disable-warning=ExperimentalWarning cli.mjs lang",
    "ai-lang": "node --disable-warning=ExperimentalWarning cli.mjs ai-lang",
    "collect": "node --disable-warning=ExperimentalWarning cli.mjs collect",
    "sync-ai": "node --disable-warning=ExperimentalWarning cli.mjs sync-ai"
  },
  "keywords": [
    "antigravity",
    "insiders",
    "i18n",
    "localization",
    "macos",
    "windows",
    "zh-cn",
    "zh-tw",
    "japanese",
    "korean",
    "russian",
    "vietnamese",
    "hindi",
    "indonesian",
    "thai",
    "spanish",
    "french",
    "german",
    "portuguese",
    "italian"
  ]
}
